          <zone fixed-size='339' forceUpdate='true' h='70128' id='13' is-fixed='true' type-v2='text' w='19333' x='80167' y='28718'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Key points:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Highest profit:</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'>Æ </run>
              <run fontcolor='#499894' fontname='Benton Sans Book'>Standard Class</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'>, with</run>
              <run fontcolor='#e15759' fontname='Benton Sans Book'> $25.4K </run>
              <run fontcolor='#000000' fontname='Benton Sans Book'>profit on </run>
              <run fontcolor='#e15759' fontname='Benton Sans Book'>$318.5K</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'> sales. It is by far the biggest revenue driver.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Lowest profit:</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'>Æ </run>
              <run fontcolor='#f28e2b' fontname='Benton Sans Book'>Same Day</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'>, with only </run>
              <run fontcolor='#e15759' fontname='Benton Sans Book'>$1.5K</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'> profit on </run>
              <run fontcolor='#e15759' fontname='Benton Sans Book'>$20.4K</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'> sales.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Best overall:</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'>Æ </run>
              <run fontcolor='#e15759' fontname='Benton Sans Book'>Second Class</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'>, because it has the highest profit margin </run>
              <run fontcolor='#e15759' fontname='Benton Sans Book'>(~8.8%)</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'>, its profit has been stable from 2014 to 2016 (about </run>
              <run fontcolor='#e15759' fontname='Benton Sans Book'>2.6K–2.8K</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'> per year), and its sales grow every year.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Worst overall:</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'> First Class, because it has the lowest profit margin</run>
              <run fontcolor='#e15759' fontname='Benton Sans Book'> (~6.3%)</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'>, and its profit collapsed from about </run>
              <run fontcolor='#e15759' fontname='Benton Sans Book'>2.3K</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'> in 2014 to losses in 2015 and 2016 (around -100 and -200), even though sales jumped in 2016.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#d9d9d9' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='8' />
              <format attr='margin' value='10' />
              <format attr='padding' value='8' />
