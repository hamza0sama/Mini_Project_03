        <zone flipboard-zone-id='5' forceUpdate='true' h='91889' id='9' story-point-id='7' type-v2='text' w='98177' x='885' y='12333'>
          <formatted-text>
            <run bold='true' fontcolor='#4e79a7' fontname='Benton Sans Book' fontsize='20'>From Sales to Profit: What We Learned and What We Do Next</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#4e79a7' fontname='Benton Sans Book'>KEY FINDINGS</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>- </run>
            <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Benton Sans Book' fontsize='11'>Limited profitability</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>: </run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>$</run>
            <run fontalignment='0' fontcolor='#59a14f' fontname='Benton Sans Book' fontsize='11'>501.2</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>K in sales vs. $</run>
            <run fontalignment='0' fontcolor='#59a14f' fontname='Benton Sans Book' fontsize='11'>39.7</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>K in profit (margin ≈ </run>
            <run fontalignment='0' fontcolor='#59a14f' fontname='Benton Sans Book' fontsize='11'>8</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>%).</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>- </run>
            <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Benton Sans Book' fontsize='11'>Shipping</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>: </run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>Standard Class drives the business ($</run>
            <run fontalignment='0' fontcolor='#59a14f' fontname='Benton Sans Book' fontsize='11'>25.4</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>K profit on $</run>
            <run fontalignment='0' fontcolor='#59a14f' fontname='Benton Sans Book' fontsize='11'>318.5</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>K sales), but its profit dropped sharply in 2016. First Class turned into losses in 2015 and 2016.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>- </run>
            <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Benton Sans Book' fontsize='11'>Products</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>: </run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>Some products reach high sales only with heavy discounts, while Canon imageCLASS leads on profit (8,400)</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>- </run>
            <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Benton Sans Book' fontsize='11'>Categories</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>: </run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>Binders and Paper lead in quantity; Machines and Copiers sell far fewer units</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>- </run>
            <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Benton Sans Book' fontsize='11'>Time</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>: </run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>Demand is seasonal and peaks in November</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>- </run>
            <run bold='true' fontalignment='0' fontcolor='#333333' fontname='Benton Sans Book' fontsize='11'>Geography</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>: </run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>Houston and Chicago lead in sales</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#76b7b2' fontname='Benton Sans Book'>RECOMMENDATIONS</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontcolor='#000000' fontname='Benton Sans Book'>- </run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>Review discount policy on high-sales, low-profit products.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>- Re-evaluate First Class pricing or terms to stop the losses.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>- Focus on the most profitable products and categories, not volume alone.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>- Prepare inventory and promotions for the Nov–Dec peak.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run fontalignment='0' fontname='Benton Sans Book' fontsize='11'>- Strengthen presence in Houston and Chicago and investigate why other cities lag.</run>
          </formatted-text>
        </zone>
      </zones>
