      <column caption='Sum of Salse by year' datatype='real' name='[Calculation_0088012478570501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])' />
      </column>
      <column caption='Profit_Color' datatype='string' name='[Calculation_1340630426284032]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;= [Parameters].[Profit ThrreShold P4 (copy)_1340630444331016] THEN &apos;3 - Above Target&apos;&#13;&#10;ELSEIF SUM([Profit]) &gt; 0 THEN &apos;2 - Profitable, Below Target&apos;&#13;&#10;ELSEIF SUM([Profit]) = 0 THEN &apos;1 - Break-even&apos;&#13;&#10;ELSE &apos;0 - Loss&apos;&#13;&#10;END' />
      </column>
      <column caption='Discount Color' datatype='string' name='[Calculation_1340630432935939]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([Discount]) &gt;= 0.7 THEN &apos;4 - Very High (70%+)&apos;&#13;&#10;ELSEIF AVG([Discount]) &gt;= 0.5 THEN &apos;3 - High (50% - 69%)&apos;&#13;&#10;ELSEIF AVG([Discount]) &gt;= 0.3 THEN &apos;2 - Medium (30% - 49%)&apos;&#13;&#10;ELSEIF AVG([Discount]) &gt; 0 THEN &apos;1 - Low (1% - 29%)&apos;&#13;&#10;ELSE &apos;0 - No Discount&apos;&#13;&#10;END' />
      </column>
      <column caption='Quantitiy Color' datatype='string' name='[Calculation_1340630445195275]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Quantity]) &gt;= [Parameters].[Parameter 1340630430654466] THEN &apos;Above Threshold&apos;&#13;&#10;ELSE &apos;Below Threshold&apos;&#13;&#10;END' />
      </column>
