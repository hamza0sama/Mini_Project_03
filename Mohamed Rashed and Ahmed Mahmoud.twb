              <calculation class='tableau' formula='IF YEAR([FullDate]) = [Parameters].[Parameter 1612212167118852]-1 THEN [Sales]&#13;&#10;END' />
            </column>
            <column caption='WINDOW_SUM(SUM([CY Sales]))' datatype='real' name='[Calculation_0397252291432448]' role='measure' type='quantitative' user:unnamed='KPI Sales'>
              <calculation class='tableau' formula='WINDOW_SUM(SUM([Calculation_1612212164878336]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WINDOW_SUM([%Diff Sales])' datatype='real' name='[Calculation_0397252291788801]' role='measure' type='quantitative' user:unnamed='KPI Sales'>
              <calculation class='tableau' formula='WINDOW_SUM([Calculation_1612212168032262])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='{[%Diff Sales]}' datatype='real' name='[Calculation_0397252295086086]' role='measure' type='quantitative' user:unnamed='KPI Sales'>
