          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Year' datatype='integer' default-format='n0;-0' name='[Parameter 1612212167118852]' param-domain-type='list' role='measure' type='quantitative' value='2016'>
              <calculation class='tableau' formula='2016' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ozp2b10p37ldz180lxp515xqye7'>
            <column caption='%Diff Profit' datatype='real' default-format='p0.0%' name='[%Diff Sales (copy)_1612212190920724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([CY Sales (copy)_1612212190605330]) - SUM([PY Sales (copy)_1612212190449681])) / SUM([PY Sales (copy)_1612212190449681])' />
            </column>
            <column caption='CY Profit' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[CY Sales (copy)_1612212190605330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([FullDate]) = [Parameters].[Parameter 1612212167118852] THEN [Profit]&#13;&#10;END' />
            </column>
            <column caption='WINDOW_SUM(SUM([CY Profit]))' datatype='real' name='[Calculation_0397252293664770]' role='measure' type='quantitative' user:unnamed='KPI Profit'>
              <calculation class='tableau' formula='WINDOW_SUM(SUM([CY Sales (copy)_1612212190605330]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Sum' caption='Current Year' datatype='integer' default-format='n0;-0' name='[Calculation_1612212180115471]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1612212167118852]' />
            </column>
            <column aggregation='Sum' caption='Previous Year' datatype='integer' default-format='n0;-0' name='[Calculation_1612212180205584]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1612212167118852]-1' />
            </column>
            <column caption='{[%Diff Profit]}' datatype='real' name='[Calculation_1612212191248407]' role='measure' type='quantitative' user:unnamed='KPI Profit'>
              <calculation class='tableau' formula='{[%Diff Sales (copy)_1612212190920724]}' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Full Date' datatype='date' name='[FullDate]' role='dimension' type='ordinal' />
            <column caption='Min/Max Profit' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Min/Max Sales (copy)_1612212190720019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([CY Sales (copy)_1612212190605330]) = WINDOW_MAX(SUM([CY Sales (copy)_1612212190605330]))&#13;&#10;THEN SUM([CY Sales (copy)_1612212190605330])&#13;&#10;ELSEIF SUM([CY Sales (copy)_1612212190605330]) = WINDOW_MIN(SUM([CY Sales (copy)_1612212190605330]))&#13;&#10;THEN SUM([CY Sales (copy)_1612212190605330])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='PY Profit' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[PY Sales (copy)_1612212190449681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([FullDate]) = [Parameters].[Parameter 1612212167118852]-1 THEN [Profit]&#13;&#10;END' />
            </column>
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
