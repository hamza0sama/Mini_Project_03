              <calculation class='tableau' formula='IF COUNTD([CY Sales (copy)_2115239149670400]) = WINDOW_MAX(COUNTD([CY Sales (copy)_2115239149670400]))&#13;&#10;THEN COUNTD([CY Sales (copy)_2115239149670400])&#13;&#10;ELSEIF COUNTD([CY Sales (copy)_2115239149670400]) = WINDOW_MIN(COUNTD([CY Sales (copy)_2115239149670400]))&#13;&#10;THEN COUNTD([CY Sales (copy)_2115239149670400])&#13;&#10;END'>
