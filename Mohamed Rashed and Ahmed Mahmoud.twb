              <calculation class='tableau' formula='(SUM([CY Sales (copy)_1612212190605330]) - SUM([PY Sales (copy)_1612212190449681])) / SUM([PY Sales (copy)_1612212190449681])' />
            </column>
            <column caption='CY Profit' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[CY Sales (copy)_1612212190605330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([FullDate]) = [Parameters].[Parameter 1612212167118852] THEN [Profit]&#13;&#10;END' />
