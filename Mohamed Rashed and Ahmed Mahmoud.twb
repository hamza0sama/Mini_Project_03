            <column caption='CY Sales' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_1612212164878336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([FullDate]) = [Parameters].[Parameter 1612212167118852] THEN [Sales]&#13;&#10;END' />
            </column>
            <column caption='%Diff Sales' datatype='real' default-format='p0.0%' name='[Calculation_1612212168032262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1612212164878336]) - SUM([CY Sales (copy)_1612212166336514])) / SUM([CY Sales (copy)_1612212166336514])' />
            </column>
