          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Year' datatype='integer' default-format='n0;-0' name='[Parameter 1612212167118852]' param-domain-type='list' role='measure' type='quantitative' value='2016'>
              <calculation class='tableau' formula='2016' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ozp2b10p37ldz180lxp515xqye7'>
            <column caption='PY Sales' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[CY Sales (copy)_1612212166336514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([FullDate]) = [Parameters].[Parameter 1612212167118852]-1 THEN [Sales]&#13;&#10;END' />
            </column>
            <column caption='WINDOW_SUM(SUM([CY Sales]))' datatype='real' name='[Calculation_0397252291432448]' role='measure' type='quantitative' user:unnamed='KPI Sales'>
              <calculation class='tableau' formula='WINDOW_SUM(SUM([Calculation_1612212164878336]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WINDOW_SUM([%Diff Sales])' datatype='real' name='[Calculation_0397252291788801]' role='measure' type='quantitative' user:unnamed='KPI Sales'>
              <calculation class='tableau' formula='WINDOW_SUM([Calculation_1612212168032262])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='{[%Diff Sales]}' datatype='real' name='[Calculation_0397252295086086]' role='measure' type='quantitative' user:unnamed='KPI Sales'>
              <calculation class='tableau' formula='{[Calculation_1612212168032262]}' />
            </column>
            <column caption='CY Sales' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_1612212164878336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([FullDate]) = [Parameters].[Parameter 1612212167118852] THEN [Sales]&#13;&#10;END' />
            </column>
            <column caption='%Diff Sales' datatype='real' default-format='p0.0%' name='[Calculation_1612212168032262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1612212164878336]) - SUM([CY Sales (copy)_1612212166336514])) / SUM([CY Sales (copy)_1612212166336514])' />
            </column>
            <column caption='Min/Max Sales' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_1612212170645511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_1612212164878336]) = WINDOW_MAX(SUM([Calculation_1612212164878336]))&#13;&#10;THEN SUM([Calculation_1612212164878336])&#13;&#10;ELSEIF SUM([Calculation_1612212164878336]) = WINDOW_MIN(SUM([Calculation_1612212164878336]))&#13;&#10;THEN SUM([Calculation_1612212164878336])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
