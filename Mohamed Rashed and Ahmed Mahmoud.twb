              <calculation class='tableau' formula='IF SUM([Calculation_1612212164878336]) = WINDOW_MAX(SUM([Calculation_1612212164878336]))&#13;&#10;THEN SUM([Calculation_1612212164878336])&#13;&#10;ELSEIF SUM([Calculation_1612212164878336]) = WINDOW_MIN(SUM([Calculation_1612212164878336]))&#13;&#10;THEN SUM([Calculation_1612212164878336])&#13;&#10;END'>
