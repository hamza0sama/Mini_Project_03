      <column caption='Profit_Color' datatype='string' name='[Calculation_1340630426284032]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;= [Parameters].[Profit ThrreShold P4 (copy)_1340630444331016] THEN &apos;Grean&apos;&#13;&#10;ELSEIF SUM([Profit]) &lt; [Parameters].[Profit ThrreShold P4 (copy)_1340630444331016] AND SUM([Profit])&gt; 0 THEN &apos;Orange &apos;&#13;&#10;ELSE &apos;Red&apos;&#13;&#10;END' />
      </column>
      <column caption='Discount Color' datatype='string' name='[Calculation_1340630432935939]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([Discount]) &gt;= 0.7 THEN &apos;Blue&apos;&#13;&#10;ELSEIF AVG([Discount]) &gt;= 0.5 THEN &apos;Green&apos;&#13;&#10;ELSEIF AVG([Discount]) &gt;= 0.3 THEN &apos;Yellow&apos;&#13;&#10;ELSEIF AVG([Discount]) &gt; 0 THEN &apos;Orange&apos;&#13;&#10;ELSE &apos;Red&apos;&#13;&#10;END' />
      </column>
      <column caption='Quantitiy Color' datatype='string' name='[Calculation_1340630445195275]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Quantity])&gt;=[Parameters].[Parameter 1340630430654466] THEN &apos;Blue&apos;&#13;&#10;ELSE &apos;Orange&apos;&#13;&#10;END' />
      </column>
